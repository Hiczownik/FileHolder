<Project>
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- CA1848: LoggerMessage delegates recommendation -->
        <!-- CA1873: Argument evaluation in logging methods -->
        <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
    </PropertyGroup>
    
    <!--
      FileHolder's version, for the API and its libraries (the UI's is in src/fileholder-ui/package.json; release-please
      bumps both). The commit is added at build time: from git locally, from the GIT_SHA build argument in Docker,
      which has no .git (README, Versions and Releases).
    -->
    <PropertyGroup>
        <Version>0.9.0</Version> <!-- x-release-please-version -->
    </PropertyGroup>

    <!-- SonarAnalyzer.CSharp is added to every project by Directory.Packages.props (a GlobalPackageReference). -->

    <!--
      NuGet audit: every restore checks all packages, the ones pulled in by others too, against the GitHub advisory
      database. A high (NU1903) or critical (NU1904) vulnerability fails the build, here and in the Docker build;
      low (NU1901) and moderate (NU1902) ones stay warnings. Fix by updating the package, or by pinning a fixed
      version of a transitive one in Directory.Packages.props.
    -->
    <PropertyGroup>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup Condition="$(MSBuildProjectName.Contains('Tests'))">
        <!--
          CA1707: Identifiers should not contain underscores (allows BDD test naming)
          S100:   Methods should be PascalCase
          S2699:  Tests should contain assertions (allows FluentAssertions .Should())
          S1186:  Methods should not be empty
          S8969:  Redundant null-forgiving operators (common in test assertions)
          CA1806: Unused results (common in assertion evaluations)
          S6966:  Async method preference in test mock setups
        -->
        <NoWarn>$(NoWarn);CA1707;S100;S2699;S1186;S8969;CA1806;S6966</NoWarn>
    </PropertyGroup>
</Project>