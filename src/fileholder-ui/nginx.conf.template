# A share token opens a bundle without a password, so the access log shows [token] in its place and leaves out
# query strings. Tokens are 8 letters and digits (CryptoUtils.GenerateShortToken); no fixed route segment is.
map $request_uri $request_path {
    "~^(?<path>[^?]*)" $path;
}

map $request_path $loggable_path {
    "~^(?<prefix>/f/|/api/v1/files/)[A-Za-z0-9]{8}(?<rest>/.*)?$" "${prefix}[token]${rest}";
    default $request_path;
}

log_format redacted '$remote_addr - [$time_local] "$request_method $loggable_path $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent"';

# Connections to the API are kept open and reused. With a new connection per request, each closed one holds a local
# port for a minute (TIME_WAIT), and above a few hundred requests a second nginx ran out of ports and answered 502
# (load scenario 6, tests/load).
upstream api {
    server api:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name localhost;

    access_log /var/log/nginx/access.log redacted;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;

        # Only here, not at server level: nginx would add them to /api/ responses too, which carry their own
        # (SecurityHeadersMiddleware). A location with an add_header of its own inherits none of these.
        #
        # The page holds link keys, passkeys and kAuth, so only the app's own scripts may run: no inline script
        # (index.html has none) and no other origin. 'wasm-unsafe-eval' lets hash-wasm compile Argon2id in the
        # passkey worker; it allows WebAssembly only, not eval. connect-src adds storage, which the page uploads to
        # and downloads from through presigned URLs; ${STORAGE_PUBLIC_URL} is filled in when the container starts
        # (docker-entrypoint.d/19-storage-public-url.envsh). font-src allows data: because the build inlines the
        # small woff fonts into the stylesheet. The download worker answers a same-origin iframe (frame-src).
        # Strict-Transport-Security comes from Caddy in production (docker/caddy/Caddyfile), which serves HTTPS.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self'; font-src 'self' data:; connect-src 'self' ${STORAGE_PUBLIC_URL}; worker-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
        # frame-ancestors covers current browsers; this is for older ones.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        # The share token is in the path; nothing needs a Referer, so none is sent anywhere.
        add_header Referrer-Policy "no-referrer" always;
    }

    # The API is reached through this proxy rather than its own published port, so it sees each client's
    # address in X-Forwarded-For instead of one shared address, and per-client rate limits work. Behind another proxy
    # (Caddy in production), $remote_addr is already the client's address, taken from that proxy's X-Forwarded-For
    # (TRUSTED_PROXIES, docker-entrypoint.d/18-trusted-proxies.envsh).
    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        # Without this nginx sends "Connection: close", and the upstream keepalive above has nothing to reuse.
        proxy_set_header Connection "";

        # Overwrite, never append: a client-supplied X-Forwarded-For would let anyone pick their own
        # rate-limit partition. The API trusts this header only from this container's address.
        proxy_set_header X-Forwarded-For $remote_addr;
        # https when a trusted proxy says so, otherwise this connection's scheme (18-trusted-proxies.envsh).
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Host $host;

        # Requests are small JSON bodies; file contents go straight to storage via presigned URLs.
        client_max_body_size 1m;

        # Stream bundle ZIPs to the client as they are built instead of buffering them here.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Gzip Compression for fast asset delivery
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
