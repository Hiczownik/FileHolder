#!/bin/sh
# Sourced by the nginx image's entrypoint before the templates are filled in. Writes /etc/nginx/conf.d/00-proxies.conf,
# which nginx.conf.template relies on for $forwarded_proto.
#
# TRUSTED_PROXIES: addresses or CIDR ranges of a reverse proxy in front of this container (Caddy in production,
# docker-compose.prod.yml), separated by spaces or commas. nginx then takes the client's address from that proxy's
# X-Forwarded-For, and the scheme from its X-Forwarded-Proto, so the access log, the API's rate limits and its password
# lockout see real clients instead of the proxy. Only list addresses nothing but your proxy can connect from: anyone
# connecting from one could claim to be any client. Unset (the default, and the dev stack), clients connect directly
# and every forwarded header they send is ignored.

trusted_proxies=$(printf '%s' "${TRUSTED_PROXIES:-}" | tr ',' ' ')
conf=/etc/nginx/conf.d/00-proxies.conf

if [ -z "$(printf '%s' "$trusted_proxies" | tr -d ' ')" ]; then
    cat > "$conf" <<'EOF'
# No trusted proxy (TRUSTED_PROXIES unset): clients connect directly.
map $scheme $forwarded_proto {
    default $scheme;
}
EOF
    return 0 2>/dev/null || exit 0
fi

{
    echo "# Written from TRUSTED_PROXIES by docker-entrypoint.d/18-trusted-proxies.envsh."
    for proxy in $trusted_proxies; do
        # An IPv4 or IPv6 address with an optional prefix length; anything else (a name, a ';') would change the
        # config, so the container refuses to start. Matches the first three lines, rejects the last two:
        # https://regex101.com/?regex=%5E%28%5B0-9%5D%7B1%2C3%7D%28%5C.%5B0-9%5D%7B1%2C3%7D%29%7B3%7D%7C%5B0-9A-Fa-f%3A%5D*%3A%5B0-9A-Fa-f%3A%5D*%29%28%2F%5B0-9%5D%7B1%2C3%7D%29%3F%24&flags=gm&testString=172.30.250.20%0A172.30.250.0%2F24%0Afd00%3A%3A1%2F64%0Acaddy%0A1.2.3.4%3B%20foo
        if ! printf '%s' "$proxy" | grep -Eq '^([0-9]{1,3}(\.[0-9]{1,3}){3}|[0-9A-Fa-f:]*:[0-9A-Fa-f:]*)(/[0-9]{1,3})?$'; then
            echo "18-trusted-proxies.envsh: TRUSTED_PROXIES must be IP addresses or CIDR ranges (e.g. 172.30.250.20); got '$proxy'" >&2
            exit 1
        fi
        echo "set_real_ip_from $proxy;"
    done
    cat <<'EOF'
real_ip_header X-Forwarded-For;
# The last address before a trusted one is the client: a value the client put in front of it is ignored.
real_ip_recursive on;

EOF
    # Whether this connection comes from a trusted proxy ($realip_remote_addr is the connection's own address, before
    # the client's replaces $remote_addr).
    echo 'geo $realip_remote_addr $from_trusted_proxy {'
    echo '    default 0;'
    for proxy in $trusted_proxies; do
        echo "    $proxy 1;"
    done
    echo '}'
    cat <<'EOF'

# The scheme the client used with the proxy, believed only from a trusted proxy and only as http or https; otherwise
# this connection's own.
map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    default   $scheme;
    "1:http"  http;
    "1:https" https;
}
EOF
} > "$conf"
