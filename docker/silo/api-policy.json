{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketChecksAndSafetyNet",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetLifecycleConfiguration",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": ["arn:aws:s3:::fileholder-bucket"]
    },
    {
      "Sid": "ObjectsAndMultipartUploads",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": ["arn:aws:s3:::fileholder-bucket/*"]
    }
  ]
}
