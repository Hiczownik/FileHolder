# The server's settings for docker-compose.prod.yml (README, Production). Copy to .env next to it on the server, fill
# in every value, and keep it there only: it holds the database password, the R2 token and the admin token. Compose
# refuses to start while a required value is missing.

# The public address Caddy gets the HTTPS certificate for; its A/AAAA records must point at this server.
SITE_ADDRESS=fileholder.app
# Certificate expiry warnings and the certificate authority's account.
ACME_EMAIL=change-me@example.com

# Which images to run: fileholder-api:<this> and fileholder-ui:<this>. deploy.ps1 sets it.
FILEHOLDER_VERSION=0.9.0

# Cloudflare R2 (README, Running on Cloudflare R2): the bucket's address (with its jurisdiction), name, and an
# Object Read & Write token limited to it.
STORAGE_PUBLIC_URL=https://<account-id>.eu.r2.cloudflarestorage.com
STORAGE_BUCKET=change-me
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me

# Long random letters and digits (e.g. openssl rand -hex 16); it goes into a connection string.
POSTGRES_PASSWORD=change-me
# At least 32 characters (e.g. openssl rand -hex 32), or the API refuses to start.
ADMIN_TOKEN=change-me

# Optional: the public demo's limits are the defaults (250 MB bundles, 24 h, 10 GB in all).
# UPLOAD_MAX_BUNDLE_BYTES=262144000
# UPLOAD_MAX_EXPIRY_HOURS=24
# UPLOAD_GLOBAL_QUOTA_BYTES=10737418240
