# Copy to .env (git ignores it) and replace every value, or generate the whole file with the command in the README
# (Quick Start). docker compose reads .env from this folder and refuses to start while any of these is missing.
# Use long random letters and digits (e.g. openssl rand -hex 16): the Postgres password goes into a connection
# string, where ; or quotes would break it.

# Grafana's admin login (user: admin).
GRAFANA_ADMIN_PASSWORD=change-me

# Postgres. Only applied when the postgres_data volume is first created (README: "Changing the passwords").
POSTGRES_PASSWORD=change-me

# The storage admin (Silo root): minio-init and the storage console at http://localhost:9001.
# The user must be 3-20 characters, the password at least 8.
STORAGE_ROOT_USER=fileholder-admin
STORAGE_ROOT_PASSWORD=change-me

# The owner's admin token for maintenance modes (scripts/admin.ps1, README: Maintenance Modes). At least 32
# characters, e.g. openssl rand -hex 32: the API refuses to start with a shorter one.
ADMIN_TOKEN=change-me

# Secret of the API's own storage user (fileholder-api), which minio-init creates. At least 8 characters.
STORAGE_API_SECRET_KEY=change-me
